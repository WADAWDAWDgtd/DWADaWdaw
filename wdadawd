local function Notify(title, message, notifType)
    local colors = {
        info = Theme.Accent, warning = Theme.Warning,
        danger = Theme.Danger, success = Theme.Success,
    }
    local c = colors[notifType or "info"]
    
    local notif = createInstance("Frame", {
        Size = UDim2.new(0, 264, 0, 0),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.05,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, NotifContainer)
    addCorner(notif, 6)
    addStroke(notif, c, 1, 0.2)
    
    local accentBar = createInstance("Frame", {
        Size = UDim2.new(0, 2, 1, 0),
        BackgroundColor3 = c,
    }, notif)
    addCorner(accentBar, 1)
    
    local content = createInstance("Frame", {
        Size = UDim2.new(1, -20, 0, 0),
        Position = UDim2.new(0, 12, 0, 10),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, notif)
    
    local titleLbl = createInstance("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14),
        Text = title,
        TextColor3 = c,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, content)
    
    local msgLbl = createInstance("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 17),
        Text = message,
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        BackgroundTransparency = 1,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, content)
    
    createInstance("Frame", {
        Size = UDim2.new(0, 0, 0, 10),
        BackgroundTransparency = 1,
    }, content)
    
    notif.Size = UDim2.new(0, 0, 0, 0)
    notif.Position = UDim2.new(0, 264, 0, 0)
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 264, 0, 0), Position = UDim2.new(0, 0, 0, 0),
    }):Play()
    
    task.delay(4, function()
        local tween = TweenService:Create(notif, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0, 264, 0, 0), BackgroundTransparency = 1,
        })
        tween:Play()
        tween.Completed:Wait()
        notif:Destroy()
    end)
end

